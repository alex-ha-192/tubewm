/*
 * tubewm Metro: Vivaldi UI modifications.            built for accent @ACCENT@
 *
 * Generated from apps/vivaldi/metro.css.in by build.py; edit the template.
 *
 * Vivaldi only loads this when CSS modifications are allowed:
 *   1. open vivaldi://experiments and tick "Allow for using CSS modifications"
 *   2. Settings > Appearance > Custom UI Modifications > select this folder
 *      (install.sh sets the folder for you when Vivaldi is closed)
 *   3. restart Vivaldi
 *
 * The tubewm theme already gives Vivaldi its colours and square corners.
 * This file only adds what a theme cannot: the Metro tab row, a clear close
 * button, the focused address field and flat speed-dial tiles. Colours come
 * from Vivaldi's own theme variables, so it follows the dark and light
 * themes and any accent change without being rebuilt. Every rule is
 * cosmetic: if Vivaldi renames something, that rule just stops applying.
 */

#browser {
    --tubewm-accent: var(--colorHighlightBg, @ACCENT@);
    --tubewm-on-accent: var(--colorHighlightFg, @ON_ACCENT@);
    --tubewm-fg: var(--colorFg, @FG@);
    --tubewm-bg: var(--colorBg, @BG@);
    /* readable greys mixed from the theme's own text and background:
       secondary text is about 7:1, quiet text about 4.5:1 */
    --tubewm-subtle: color-mix(in srgb, var(--tubewm-fg) 66%, var(--tubewm-bg));
    --tubewm-quiet: color-mix(in srgb, var(--tubewm-fg) 52%, var(--tubewm-bg));
    --tubewm-hover: color-mix(in srgb, var(--tubewm-fg) 10%, var(--tubewm-bg));
    --tubewm-ease: cubic-bezier(0.1, 0.9, 0.2, 1);
    font-family: "Open Sans", "Noto Sans", "DejaVu Sans", sans-serif;
}

/* --- tabs: plain text on the tab bar; the active tab is bright with an
       accent underline, inactive tabs are secondary grey ------------------ */
#browser .tab-position .tab,
#browser .tab-position .tab:hover {
    background: transparent !important;
    border-color: transparent !important;
}
#browser .tab-position .tab .title {
    font-size: 13px;
    font-weight: 400;
    color: var(--tubewm-subtle) !important;
    transition: color 120ms var(--tubewm-ease);
}
#browser .tab-position .tab:hover .title {
    color: var(--tubewm-fg) !important;
}
#browser .tab-position .tab.active .title {
    color: var(--tubewm-fg) !important;
    font-weight: 600;
}
#browser .tab-position .tab.active {
    box-shadow: inset 0 -2px 0 var(--tubewm-accent) !important;
}

/* close button: a clear X, white on the active tab and when pointed at */
#browser .tab-position .tab .close {
    color: var(--tubewm-subtle) !important;
    background: transparent !important;
    opacity: 1 !important;
}
#browser .tab-position .tab .close svg,
#browser .tab-position .tab .close svg path {
    fill: currentColor !important;
    opacity: 1 !important;
}
#browser .tab-position .tab:not(.active):not(:hover) .close {
    visibility: hidden;
}
#browser .tab-position .tab.active .close,
#browser .tab-position .tab .close:hover {
    color: var(--tubewm-fg) !important;
}
#browser .tab-position .tab .close:hover {
    background: var(--tubewm-hover) !important;
}
#browser .tab-position .tab .close:active {
    color: var(--tubewm-on-accent) !important;
    background: var(--tubewm-accent) !important;
}

/* --- address field: flat, with a 2px accent edge while you type ---------- */
#browser .UrlBar-AddressField,
#browser .UrlBar-SearchField {
    border: 2px solid transparent !important;
    box-shadow: none !important;
    transition: border-color 120ms var(--tubewm-ease);
}
#browser .UrlBar-AddressField:focus-within,
#browser .UrlBar-SearchField:focus-within {
    border-color: var(--tubewm-accent) !important;
}
#browser .UrlFragment--Lowlight {
    color: var(--tubewm-subtle) !important;
}

/* --- panels: a large light header, like a Metro page title ---------------- */
#browser .panel-group header h1,
#browser .panel .panel-header h1 {
    font-size: 24px;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: lowercase;
}

/* --- popups and menus: flat sheets, no drop shadow ------------------------ */
#browser .menu,
#browser .vivaldi-menu,
.menu-container,
#browser .UrlBar-Popup,
#browser .OmniDropdown {
    box-shadow: none !important;
}

/* --- start page: speed dials as flat tiles with the name bottom-left ----- */
.startpage .dial,
.SpeedDialView .dial {
    box-shadow: none !important;
    outline: 0 !important;
    transition: transform 140ms var(--tubewm-ease);
}
.startpage .dial:hover,
.SpeedDialView .dial:hover {
    outline: 2px solid var(--tubewm-accent, @ACCENT@) !important;
}
.startpage .dial:active,
.SpeedDialView .dial:active {
    transform: scale(0.97);
}
.startpage .dial .title,
.SpeedDialView .dial .title {
    text-align: left !important;
    font-weight: 600;
    font-size: 12px;
}

@media (prefers-reduced-motion: reduce) {
    #browser *, .startpage * { transition: none !important; animation: none !important; }
}

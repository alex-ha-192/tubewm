/*
 * tubewm Metro for Firefox (generated, accent @ACCENT@, @MODE@).
 * Do not edit: re-run apps/install.sh. Loaded by an @import line at the top
 * of <profile>/chrome/userChrome.css; needs the pref
 * toolkit.legacyUserProfileCustomizations.stylesheets = true (install.sh sets
 * it in user.js).
 *
 * Black chrome, white text, one accent: the active tab is marked by an
 * accent underline, the address field gets an accent edge while you type,
 * menus are flat charcoal sheets. Firefox renames internals now and then;
 * every rule is cosmetic and simply stops applying if its target goes away.
 */

:root {
    --tubewm-accent: @ACCENT@;
    --tubewm-on-accent: @ON_ACCENT@;
    --tubewm-bg: @BG@;
    --tubewm-surface: @SURFACE@;
    --tubewm-hover: @SURFACE_ALT@;
    --tubewm-fg: @FG@;
    --tubewm-subtle: @FG_SUBTLE@;
    --tubewm-ease: cubic-bezier(0.1, 0.9, 0.2, 1);

    /* Firefox's own theme variables */
    --lwt-accent-color: var(--tubewm-bg) !important;
    --lwt-text-color: var(--tubewm-fg) !important;
    --toolbar-bgcolor: var(--tubewm-bg) !important;
    --toolbar-color: var(--tubewm-fg) !important;
    --toolbar-field-background-color: var(--tubewm-surface) !important;
    --toolbar-field-color: var(--tubewm-fg) !important;
    --toolbar-field-focus-background-color: var(--tubewm-surface) !important;
    --toolbar-field-focus-color: var(--tubewm-fg) !important;
    --toolbar-field-focus-border-color: var(--tubewm-accent) !important;
    --toolbar-field-border-color: transparent !important;
    --tab-selected-bgcolor: transparent !important;
    --tab-selected-textcolor: var(--tubewm-fg) !important;
    --tab-hover-background-color: transparent !important;
    --arrowpanel-background: var(--tubewm-surface) !important;
    --arrowpanel-color: var(--tubewm-fg) !important;
    --arrowpanel-border-color: transparent !important;
    --arrowpanel-border-radius: 0 !important;
    --panel-separator-color: var(--tubewm-hover) !important;
    --sidebar-background-color: var(--tubewm-bg) !important;
    --sidebar-text-color: var(--tubewm-fg) !important;
    --focus-outline-color: var(--tubewm-accent) !important;
    --toolbarbutton-border-radius: 0 !important;
    --tab-border-radius: 0 !important;
    --border-radius-small: 0 !important;
    --border-radius-medium: 0 !important;
    --toolbarbutton-hover-background: var(--tubewm-hover) !important;
    --toolbarbutton-active-background: var(--tubewm-hover) !important;
    --urlbarView-highlight-background: var(--tubewm-accent) !important;
    --urlbarView-highlight-color: var(--tubewm-on-accent) !important;
    --chrome-content-separator-color: var(--tubewm-bg) !important;
    font-family: "@FONT_UI@", "Noto Sans", sans-serif;
}

#navigator-toolbox { border-bottom: 0 !important; }
#urlbar-background, menupopup, panel { border-radius: 0 !important; }
menupopup, panel { --panel-shadow-margin: 0px !important; }

/* tabs: plain text, secondary grey when inactive, white and underlined in
   the accent when active */
.tabbrowser-tab .tab-background {
    background: transparent !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
}
.tabbrowser-tab .tab-label {
    color: var(--tubewm-subtle);
    transition: color 120ms var(--tubewm-ease);
}
.tabbrowser-tab:hover .tab-label,
.tabbrowser-tab[selected] .tab-label {
    color: var(--tubewm-fg) !important;
}
.tabbrowser-tab[selected] .tab-label { font-weight: 600; }
.tabbrowser-tab[selected] .tab-background {
    box-shadow: inset 0 -2px 0 var(--tubewm-accent) !important;
}

/* close button: always clear, white when pointed at */
.tabbrowser-tab .tab-close-button {
    fill: var(--tubewm-subtle) !important;
    fill-opacity: 1 !important;
    opacity: 1 !important;
}
.tabbrowser-tab[selected] .tab-close-button,
.tabbrowser-tab .tab-close-button:hover {
    fill: var(--tubewm-fg) !important;
}
.tabbrowser-tab .tab-close-button:hover {
    background: var(--tubewm-hover) !important;
}

/* address field: flat, with a 2px accent edge while you type */
#urlbar-background {
    border: 2px solid transparent !important;
    transition: border-color 120ms var(--tubewm-ease);
}
#urlbar[focused] > #urlbar-background,
#urlbar[open] > #urlbar-background {
    border-color: var(--tubewm-accent) !important;
}

/* menus: flat sheets; the item under the pointer is filled with the accent */
menupopup menuitem[_moz-menuactive],
menupopup menu[_moz-menuactive] {
    background: var(--tubewm-accent) !important;
    color: var(--tubewm-on-accent) !important;
}

@media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
}

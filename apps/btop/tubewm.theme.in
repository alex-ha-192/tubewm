# tubewm Metro for btop (generated, accent @ACCENT@). Do not edit: re-run apps/install.sh.
# Selected with  color_theme = "tubewm"  in btop.conf.

theme[main_bg]="@BG@"
theme[main_fg]="@FG@"
theme[title]="@FG@"
theme[hi_fg]="@ACCENT_TEXT@"
theme[selected_bg]="@ACCENT@"
theme[selected_fg]="@ON_ACCENT@"
theme[inactive_fg]="@FG_DISABLED@"
theme[graph_text]="@FG_SUBTLE@"
theme[meter_bg]="@SURFACE@"
theme[proc_misc]="@FG_SUBTLE@"
theme[cpu_box]="@SURFACE_ALT@"
theme[mem_box]="@SURFACE_ALT@"
theme[net_box]="@SURFACE_ALT@"
theme[proc_box]="@SURFACE_ALT@"
theme[div_line]="@SURFACE_ALT@"

# every graph is one accent ramp: dark to full to light
theme[temp_start]="@SELECTION@"
theme[temp_mid]="@ACCENT@"
theme[temp_end]="@ACCENT_HOVER@"
theme[cpu_start]="@SELECTION@"
theme[cpu_mid]="@ACCENT@"
theme[cpu_end]="@ACCENT_HOVER@"
theme[free_start]="@SELECTION_SOFT@"
theme[free_mid]="@SELECTION@"
theme[free_end]="@ACCENT@"
theme[cached_start]="@SELECTION_SOFT@"
theme[cached_mid]="@SELECTION@"
theme[cached_end]="@ACCENT@"
theme[available_start]="@SELECTION_SOFT@"
theme[available_mid]="@SELECTION@"
theme[available_end]="@ACCENT@"
theme[used_start]="@SELECTION@"
theme[used_mid]="@ACCENT@"
theme[used_end]="@ACCENT_HOVER@"
theme[download_start]="@SELECTION@"
theme[download_mid]="@ACCENT@"
theme[download_end]="@ACCENT_HOVER@"
theme[upload_start]="@SURFACE_ALT@"
theme[upload_mid]="@FG_SUBTLE@"
theme[upload_end]="@FG@"
theme[process_start]="@SELECTION@"
theme[process_mid]="@ACCENT@"
theme[process_end]="@ACCENT_HOVER@"

# ┌──────────────────────────────────────────────────────────────────────┐
# │ tubewm · sway config                                                 │
# │                                                                      │
# │ Content over chrome: no title bars, no rounded corners, no shadows.  │
# │ One accent colour, flat surfaces, big lowercase type.                │
# │                                                                      │
# │ Installed once by desktop/install.sh. Edit freely; your own snippets │
# │ can also live in ~/.config/sway/config.d/*.conf.                     │
# │ Colours come from ~/.config/sway/tubewm-colors, which tube-accent    │
# │ regenerates, so don't edit that one.                                 │
# └──────────────────────────────────────────────────────────────────────┘

include ~/.config/sway/tubewm-colors

### Variables ---------------------------------------------------------------

set $mod Mod4
set $alt Mod1
set $term foot

# Workspaces are pivots: lowercase names that the bar shows as big headers.
# Rename them to suit how you work; the number prefix only sets the order.
set $ws1  "1:home"
set $ws2  "2:web"
set $ws3  "3:code"
set $ws4  "4:chat"
set $ws5  "5:music"
set $ws6  "6:video"
set $ws7  "7:files"
set $ws8  "8:play"
set $ws9  "9:misc"
set $ws10 "10:extra"

### Look --------------------------------------------------------------------

font pango:Open Sans 10

# Thin flat focus border, nothing else.
default_border pixel 2
default_floating_border pixel 2
titlebar_border_thickness 0
titlebar_padding 1
hide_edge_borders --i3 smart

# Windows meet edge to edge, with no gaps between them.
gaps inner 0
gaps outer 0

# Obsidian backdrop. Put `output * bg /path/to/image fill` in config.d to
# use a picture instead.
output * bg $tube_shell solid_color

### Input -------------------------------------------------------------------

input type:touchpad {
    tap enabled
    natural_scroll enabled
    # Ignore the touchpad while typing, and while the trackpoint is in use,
    # so a palm resting on it doesn't move the pointer or click.
    dwt enabled
    dwtp enabled
    # Two fingers pressed down is a right click, wherever they are.
    click_method clickfinger
    middle_emulation enabled
}

input type:keyboard {
    # British English. Change to us, de, fr... to suit your keyboard.
    xkb_layout gb
    repeat_delay 300
    repeat_rate 40
}

focus_follows_mouse yes
mouse_warping none
floating_modifier $mod normal

### Shell -------------------------------------------------------------------

# Bar (pivot headers + status).
bar {
    swaybar_command waybar
}

exec mako
exec swayidle -w \
    timeout 300 'tube-lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'tube-lock'

# Let portals and user services see the Wayland session.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK

### Keys: shell -------------------------------------------------------------

bindsym $mod+s exec tube-start
bindsym $mod+d exec tube-start --apps
bindsym $mod+c exec tube-charms
bindsym $mod+i exec tube-charms --settings
bindsym $mod+q exec tube-start --search
bindsym $mod+Return exec $term
bindsym $mod+l exec tube-lock
bindsym $mod+z exec pkill -SIGUSR1 waybar
bindsym $mod+Tab exec tube-switcher
bindsym $mod+Shift+e exec tube-charms --power

# Uncomment to open start by tapping the Super key on its own.
# bindsym --release Super_L exec tube-start

### Keys: windows -----------------------------------------------------------

bindsym $alt+F4 kill
bindsym $mod+w kill

bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down

# Snap: dock the focused window as a narrow column at the left or right
# edge (320 px), the other windows fill the rest. Press again to widen to
# 500 px. $mod+slash gives everything equal space again.
bindsym $mod+comma  exec tube-snap left
bindsym $mod+period exec tube-snap right
bindsym $mod+slash  exec tube-snap fill

bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+b splith
bindsym $mod+n splitv
bindsym $mod+t layout toggle split tabbed

mode "resize" {
    bindsym Left  resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up    resize shrink height 20px
    bindsym Down  resize grow height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Keys: pivots (workspaces) -----------------------------------------------

bindsym $mod+Ctrl+Right workspace next_on_output
bindsym $mod+Ctrl+Left  workspace prev_on_output
bindsym $mod+grave workspace back_and_forth

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

bindsym $mod+Ctrl+Shift+Right move container to workspace next_on_output, workspace next_on_output
bindsym $mod+Ctrl+Shift+Left  move container to workspace prev_on_output, workspace prev_on_output


### Gestures (touchpad / touchscreen) ---------------------------------------

# Swipe between pivots with three fingers, like panning a panorama.
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left  workspace next_on_output
bindgesture swipe:3:up    exec tube-start
bindgesture swipe:3:down  exec tube-switcher
bindgesture swipe:4:left  exec tube-charms
bindgesture swipe:4:right exec tube-charms --close

### Hardware keys -----------------------------------------------------------

bindsym --locked XF86AudioRaiseVolume  exec tube-osd volume up
bindsym --locked XF86AudioLowerVolume  exec tube-osd volume down
bindsym --locked XF86AudioMute         exec tube-osd volume mute
bindsym --locked XF86AudioMicMute      exec tube-osd mic mute
bindsym --locked XF86MonBrightnessUp   exec tube-osd brightness up
bindsym --locked XF86MonBrightnessDown exec tube-osd brightness down
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioPrev  exec playerctl previous

bindsym Print       exec tube-share screen
bindsym Shift+Print exec tube-share region

### Window rules ------------------------------------------------------------

for_window [window_role="pop-up"]  floating enable
for_window [window_role="dialog"]  floating enable
for_window [window_type="dialog"]  floating enable
for_window [app_id="pavucontrol"]  floating enable, resize set 640 480
for_window [app_id="blueman-manager"] floating enable, resize set 640 480
for_window [app_id="nm-connection-editor"] floating enable
for_window [title="(?i)picture.in.picture"] floating enable, sticky enable

# Session lock on suspend/resume is handled by swayidle above.

include ~/.config/sway/config.d/*.conf

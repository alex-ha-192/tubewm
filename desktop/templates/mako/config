# Generated by tube-render. Do not edit: run `tube-accent` to recolour.
# Toasts: plain charcoal cards, top right under the bar: the app icon, a
# title and the message. Click one to open the app; it goes away on
# its own after 6 seconds.

font=Open Sans 11
anchor=top-right
layer=overlay
width=400
height=160
outer-margin=12
margin=0,0,8,0
padding=16,20
border-size=1
border-color=@SURFACE_HI@
border-radius=0
background-color=@SURFACE@
text-color=@FG@
icons=1
max-icon-size=44
icon-location=left
max-visible=3
sort=-time
default-timeout=6000
ignore-timeout=0
markup=1
progress-color=over @ACCENT@
on-button-left=invoke-default-action
on-button-right=dismiss
format=<span weight="600" size="large">%s</span>\n<span foreground="#D0D0D0">%b</span>

[body=""]
format=<span weight="600" size="large">%s</span>

[urgency=low]
default-timeout=4000

[urgency=high]
border-color=@URGENT@
border-size=2
default-timeout=0

# Fallback for the volume / brightness indicator when the compositor has
# no layer shell; normally tube-osd draws its own.
[app-name=tube-osd]
anchor=bottom-center
outer-margin=64
width=340
height=64
format=<span size="large">%s  %b</span>
default-timeout=1500
group-by=app-name

[mode=do-not-disturb]
invisible=1

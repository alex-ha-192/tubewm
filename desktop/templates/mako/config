# Generated by tube-render. Do not edit: run `tube-accent` to recolour.
# Toasts: flat accent rectangles, top right, one at a time.

font=Open Sans 11
anchor=top-right
layer=overlay
width=380
height=140
outer-margin=20
margin=0,0,10,0
padding=16,20
border-size=0
border-radius=0
icons=1
max-icon-size=40
icon-location=left
max-visible=3
sort=-time
default-timeout=6000
ignore-timeout=0
markup=1
background-color=@ACCENT@
text-color=@FG@
progress-color=over @ACCENT_DARK@
format=<span size="small" weight="600">%a</span>\n<span size="x-large" weight="300">%s</span>\n%b

[urgency=low]
background-color=@SURFACE@
text-color=@FG@

[urgency=high]
background-color=@URGENT@
default-timeout=0

[app-name=tube-osd]
anchor=top-left
width=300
height=120
background-color=@SURFACE@
progress-color=over @ACCENT@
default-timeout=1500
group-by=app-name
format=<span size="small" weight="600">%s</span>\n<span size="xx-large" weight="300">%b</span>

[mode=do-not-disturb]
invisible=1

# Generated by tube-render. Do not edit: run `tube-accent` to recolour.
# Toasts: a band across the top in the accent colour, as Windows Phone did:
# who it's from, then the message, on one line. Click it to open the app;
# it goes away on its own after a few seconds, whatever the app asked for,
# and stays in the list under the time.

font=Open Sans 12
anchor=top-center
layer=overlay
width=1200
height=96
outer-margin=0
margin=0
padding=10,24
border-size=0
border-radius=0
background-color=@ACCENT@
text-color=@FG@
icons=0
max-visible=1
sort=-time
default-timeout=5000
# Apps may ask for a toast to stay until dismissed; tubewm's never do.
ignore-timeout=1
max-history=20
markup=1
progress-color=over @ACCENT_DARK@
on-button-left=invoke-default-action
on-button-right=dismiss
format=<b>%s</b>   %b

[body=""]
format=<b>%s</b>

[urgency=low]
default-timeout=3000

[urgency=high]
background-color=@URGENT@
default-timeout=8000

# Fallback for the volume / brightness indicator when the compositor has
# no layer shell; normally tube-osd draws its own band.
[app-name=tube-osd]
background-color=@SURFACE@
format=%s   %b

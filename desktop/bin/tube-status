#!/usr/bin/env python3
"""tube-status: see desktop/shell/tubewm_shell/status.py."""
import os
import signal
import sys

here = os.path.dirname(os.path.realpath(__file__))
for path in (os.path.join(here, "..", "shell"),
             os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                          "tubewm", "desktop", "shell")):
    if os.path.isdir(os.path.join(path, "tubewm_shell")):
        sys.path.insert(0, os.path.abspath(path))
        break

# The panel stays running once it has been opened (or since login): if it
# is, just tell it, which is far quicker than loading GTK first. (Keep in
# step with status.SIGNALS.)
from tubewm_shell import resident  # noqa: E402

args = sys.argv[1:]
if args in ([], ["--close"]):
    if resident.send("status", signal.SIGHUP if args else signal.SIGUSR1, answer_within=1.0) or args:
        sys.exit(0)

from tubewm_shell.status import main  # noqa: E402

sys.exit(main())

#!/usr/bin/env python3
"""tube-start: see desktop/shell/tubewm_shell/start.py."""
import os
import signal
import sys

here = os.path.dirname(os.path.realpath(__file__))
for path in (os.path.join(here, "..", "shell"),
             os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
                          "tubewm", "desktop", "shell")):
    if os.path.isdir(os.path.join(path, "tubewm_shell")):
        sys.path.insert(0, os.path.abspath(path))
        break

# Start stays running once it has been opened: if it is, just tell it, which
# is far quicker than loading GTK first. (Keep in step with start.SIGNALS.)
from tubewm_shell import resident  # noqa: E402

args = sys.argv[1:]
if set(args) <= {"--apps", "--search", "--close"} and len(args) <= 1:
    sig = (signal.SIGHUP if "--close" in args else
           signal.SIGUSR2 if "--search" in args else signal.SIGUSR1)
    if resident.send("start", sig) or "--close" in args:
        sys.exit(0)

from tubewm_shell.start import main  # noqa: E402

sys.exit(main())

#!/usr/bin/env bash
# tube-share: the "share" charm. Takes a screenshot, copies it to the
# clipboard and saves it to ~/Pictures/Screenshots.
#   tube-share screen | region | window
PATH="$(dirname "$(readlink -f "$0")"):$PATH"  # find the other tube-* commands
set -euo pipefail
mode=${1:-screen}
dir=${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png

case $mode in
    screen) grim "$file" ;;
    region) geom=$(slurp -b 00000088 -c ffffffff -w 2) || exit 0; grim -g "$geom" "$file" ;;
    window) geom=$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused? == true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | head -n1)
            grim -g "$geom" "$file" ;;
    *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

command -v wl-copy >/dev/null && wl-copy --type image/png < "$file"
notify-send -a share -i "$file" "screenshot" "copied, and saved to $(basename "$file")" 2>/dev/null || true

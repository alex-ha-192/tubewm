#!/usr/bin/env bash
# tube-idle: what happens when you step away, and when the lid closes.
#
#   4 min idle   the screen dims (any key or touch brings it back)
#   5 min idle   the session locks
#   lid closed   logind suspends the laptop; the screen is locked first,
#                and swayidle waits until the lock screen has been drawn
#                before letting it sleep, so waking shows the lock screen
#                and never a glimpse of the desktop
#
# The screen turning off is the compositor's job (Wayfire: [idle]
# dpms_timeout; Sway: its own config). Apps playing video keep all of
# this away through the idle-inhibit protocol.
PATH="$(dirname "$(readlink -f "$0")"):$PATH"  # find the other tube-* commands
set -u

command -v swayidle >/dev/null || { echo "tube-idle: swayidle is not installed" >&2; exit 1; }
pkill -x -u "$(id -u)" swayidle 2>/dev/null

dim=()
if command -v brightnessctl >/dev/null && brightnessctl -l -c backlight 2>/dev/null | grep -q backlight; then
    # Half the current brightness, never brighter; put back as it was.
    # shellcheck disable=SC2016 # swayidle runs it with sh, later
    dim=(timeout 240 'brightnessctl -q -s set $(( $(brightnessctl get) / 2 ))' resume 'brightnessctl -q -r')
fi

exec swayidle -w \
    "${dim[@]}" \
    timeout 300 'loginctl lock-session' \
    lock 'tube-lock' \
    before-sleep 'tube-lock --before-sleep'
